{
  "name": "imperio-sofas-vale",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check next.config.ts playwright.config.ts lighthouserc.json postcss.config.mjs eslint.config.mjs scripts/check-production-ready.mjs README.md docs .github/workflows/ci.yml proxy.ts src/index.css src/app src/sections/Header.tsx src/sections/BottomNavigation.tsx src/lib/env src/lib/supabase src/lib/money.ts src/lib/links.ts src/features/catalog src/features/auth tests \"src/app/(storefront)\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "lhci": "lhci autorun --config=./lighthouserc.json",
    "knip": "knip",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "check:production": "node scripts/check-production-ready.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.117.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "framer-motion": "^13.2.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.40.0",
    "next": "^16.3.6",
    "prettier": "^3.9.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intersection-observer": "^11.0.1",
    "server-only": "^0.0.1",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@knip/mcp": "0.0.36",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint-config-prettier": "^10.1.8",
    "knip": "6.38.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2"
  }
}
