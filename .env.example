# Runtime mode. Local safely defaults to APP_ENV=local and CATALOG_SOURCE=local.
# Staging/production must explicitly set APP_ENV and CATALOG_SOURCE=supabase.
# Production additionally requires INTEGRATION_MODE=live and external evidence.
APP_ENV=local
APP_URL=http://localhost:3000
INTEGRATION_MODE=mock
CATALOG_SOURCE=local

# Supabase (public URL/key are still protected by RLS; service key is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set true only after the matching provider is enabled and verified in Supabase Auth.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (server-only)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_EXPECTED_COLLECTOR_ID=
MP_ENV=sandbox

# Bling OAuth (tokens are stored encrypted later; never commit them)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=http://localhost:3000/api/integrations/bling/callback
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_KEY_VERSION=1

# E-mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Jobs and commercial quote signing
CRON_SECRET=
QUOTE_SIGNING_SECRET=

# Optional observability
SENTRY_DSN=
