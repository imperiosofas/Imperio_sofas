# ---------------------------------------------------------------------------
# Império Sofás — PRODUCTION environment variables (template, no real values)
#
# Paste each real value directly in Vercel → Project → Settings → Environment
# Variables (Production). Never commit real values. NEXT_PUBLIC_* variables are
# public by design (protected by RLS); every other variable is server-only.
# Full table with owners and formats: docs/production/PRODUCTION_ENV_TEMPLATE.md
# Check: `npm run check:production` (prints names, never values).
# ---------------------------------------------------------------------------

# --- Runtime mode (fixed values) -------------------------------------------
APP_ENV=production
CATALOG_SOURCE=supabase
INTEGRATION_MODE=live
# Final public URL, https, no trailing path. Depends on the domain decision.
APP_URL=https://<dominio-final>

# --- Supabase PRODUCTION project (never the TEST project) ------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
# Server-only secret key (sb_secret_...). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=<sb_secret_...>

# --- Mercado Pago PRODUCTION (client's account) -----------------------------
# Access Token from "Credenciais de produção" (not "de teste").
MP_ACCESS_TOKEN=<APP_USR-...>
# "Assinatura secreta" of the PRODUCTION webhook (Suas integrações → Webhooks).
MP_WEBHOOK_SECRET=<assinatura-secreta>
# Must be exactly "live" in production (anything else disables checkout).
MP_ENV=live
# Numeric user id of the account that receives the money. Payments to any
# other account are rejected.
MP_EXPECTED_COLLECTOR_ID=<123456789>

# --- E-mail (Resend) --------------------------------------------------------
RESEND_API_KEY=<re_...>
# Sender on a domain verified in Resend.
RESEND_FROM_EMAIL=Império Sofás <pedidos@<dominio-verificado>>
# Optional: store copy of order e-mails (default: company e-mail in the code).
STORE_NOTIFY_EMAIL=<email-da-loja>

# --- Jobs -------------------------------------------------------------------
# Random, 32+ characters. Protects /api/cron/expire-orders.
CRON_SECRET=<32+ caracteres aleatórios>

# --- Optional ---------------------------------------------------------------
# Error monitoring. Leave unset if Sentry is not used.
# SENTRY_DSN=
# Social login: only "true" after the provider is enabled in Supabase Auth.
# NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# --- Optional integration: Bling (ERP) — NOT used by the store today --------
# Set all four only if the client decides to use Bling; a partial set fails
# check:production.
# BLING_CLIENT_ID=
# BLING_CLIENT_SECRET=
# BLING_REDIRECT_URI=
# INTEGRATION_ENCRYPTION_KEY=

# --- Do NOT set in production -----------------------------------------------
# NEXT_PUBLIC_DISABLE_PASSWORD_EMAIL_MFA (development-only, ignored in prod)
# QUOTE_SIGNING_SECRET (declared but not read by the code)
